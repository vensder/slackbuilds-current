#   SUCH DAMAGE.
# -----------------------------------------------------------------------------
#
# Slackware SlackBuild script
# ===========================
# For:         zyn-fusion
# Descr:       ZynAddSubFX synthesizer with the Zyn-Fusion (zest) user interface
# URL:         https://zynaddsubfx.sourceforge.io/
# Build needs: ruby (with rake), libuv, mesa, X11 libs
# Needs:       jack2, liblo, mxml, portaudio
# Changelog:
# 3.0.6-1:     13/nov/2026
#              * Initial build of zynaddsubfx 3.0.6 with GuiModule=zest and
#                the matching official zyn-fusion-ui-src-3.0.6 release
#                tarball (mruby-zest-build tag 3.0.6, submodules included).
#              * Patches from alien/zynaddsubfx: cstdint include, mxml 4.
#              * CMAKE_POLICY_VERSION_MINIMUM=3.5 for CMake 4; -o pipefail.
#              * The UI goes to /opt/zyn-fusion (zynaddsubfx and the LV2/VST
#                UI look for /opt/zyn-fusion/{zyn-fusion,libzest.so}).
#              * Conflicts with the zynaddsubfx package (same files).
#
# Run 'sh zyn-fusion.SlackBuild' to build a Slackware package.
# The package (.t?z) and .txt file as well as build logs are created in /tmp .
# Install the package using 'installpkg' or 'upgradepkg --install-new'.
#
# -----------------------------------------------------------------------------

PRGNAM=zyn-fusion
VERSION=${VERSION:-3.0.6}
BUILD=${BUILD:-1}
NUMJOBS=${NUMJOBS:-" -j$(nproc) "}
TAG=${TAG:-vensder}

DOCS="AUTHORS.txt COPYING NEWS.txt README.adoc"

# Where do we look for sources?
SRCDIR=$(cd $(dirname $0); pwd)

# Place to build (TMP) package (PKG) and output (OUTPUT) the program:
TMP=${TMP:-/tmp/build}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

# Both official release tarballs (they unpack to zynaddsubfx-$VERSION/ and
# zyn-fusion-ui-src-$VERSION/):
SOURCE[0]="$SRCDIR/zynaddsubfx-${VERSION}.tar.bz2"
SRCURL[0]="https://downloads.sourceforge.net/zynaddsubfx/zynaddsubfx-${VERSION}.tar.bz2"
SOURCE[1]="$SRCDIR/zyn-fusion-ui-src-${VERSION}.tar.bz2"
SRCURL[1]="https://downloads.sourceforge.net/zynaddsubfx/zyn-fusion-ui-src-${VERSION}.tar.bz2"

##
## --- with a little luck, you won't have to edit below this point --- ##
##

# Automatically determine the architecture we're building on:
if [ -z "$ARCH" ]; then
  case "$(uname -m)" in
    i?86) ARCH=i586 ;;
    arm*) readelf /usr/bin/file -A | egrep -q "Tag_CPU.*[4,5]" && ARCH=arm || ARCH=armv7hl ;;
    # Unless $ARCH is already set, use uname -m for all other archs:
    *) ARCH=$(uname -m) ;;
  esac
  export ARCH
fi
# Set CFLAGS/CXXFLAGS and LIBDIRSUFFIX:
case "$ARCH" in
  i?86)      SLKCFLAGS="-O2 -march=${ARCH} -mtune=i686"
             SLKLDFLAGS=""; LIBDIRSUFFIX=""
             ;;
  x86_64)    SLKCFLAGS="-O2 -fPIC"
             SLKLDFLAGS="-L/usr/lib64"; LIBDIRSUFFIX="64"
             ;;
  armv7hl)   SLKCFLAGS="-O2 -march=armv7-a -mfpu=vfpv3-d16"
             SLKLDFLAGS=""; LIBDIRSUFFIX=""
             ;;
  *)         SLKCFLAGS=${SLKCFLAGS:-"-O2"}
             SLKLDFLAGS=${SLKLDFLAGS:-""}; LIBDIRSUFFIX=${LIBDIRSUFFIX:-""}
             ;;
esac

case "$ARCH" in
    arm*)    TARGET=$ARCH-slackware-linux-gnueabi ;;
    *)       TARGET=$ARCH-slackware-linux ;;
esac

# Exit the script on errors:
set -e
# Fail when cmake/make fails, not only when tee does:
set -o pipefail
trap 'echo "$0 FAILED at line ${LINENO}" | tee $OUTPUT/error-${PRGNAM}.log' ERR
# Catch unitialized variables:
set -u
P1=${1:-1}

# Save old umask and set to 0022:
_UMASK_=$(umask)
umask 0022

# Create working directories:
mkdir -p $OUTPUT          # place for the package to be saved
mkdir -p $TMP/tmp-$PRGNAM # location to build the source
mkdir -p $PKG             # place for the package to be built
rm -rf $PKG/*             # always erase old package's contents
rm -rf $TMP/tmp-$PRGNAM/* # remove the remnants of previous build
rm -rf $OUTPUT/{configure,make,install,error,makepkg,patch}-$PRGNAM.log
                          # remove old log files

# Source file availability:
for (( i = 0; i < ${#SOURCE[*]}; i++ )) ; do
  if ! [ -f ${SOURCE[$i]} ]; then
    echo "Source '$(basename ${SOURCE[$i]})' not available yet..."
    # Check if the $SRCDIR is writable at all - if not, download to $OUTPUT
    [ -w "$SRCDIR" ] || SOURCE[$i]="$OUTPUT/$(basename ${SOURCE[$i]})"
    if [ -f ${SOURCE[$i]} ]; then echo "Ah, found it!"; continue; fi
    if ! [ "x${SRCURL[$i]}" == "x" ]; then
      echo "Will download file to $(dirname $SOURCE[$i])"
      wget --no-check-certificate -nv -T 20 -O "${SOURCE[$i]}" "${SRCURL[$i]}" || true
      if [ $? -ne 0 -o ! -s "${SOURCE[$i]}" ]; then
        echo "Fail to download '$(basename ${SOURCE[$i]})'. Aborting the build."
        mv -f "${SOURCE[$i]}" "${SOURCE[$i]}".FAIL
        exit 1
      fi
    fi
    if [ ! -f "${SOURCE[$i]}" -o ! -s "${SOURCE[$i]}" ]; then
      echo "File '$(basename ${SOURCE[$i]})' not available. Aborting the build."
      exit 1
    fi
  fi
done

if [ "$P1" == "--download" ]; then
  echo "Download complete."
  exit 0
fi

# --- PACKAGE BUILDING ---

echo "++"
echo "|| $PRGNAM-$VERSION"
echo "++"

cd $TMP/tmp-$PRGNAM
echo "Extracting the source archive(s) for $PRGNAM..."
tar -xf ${SOURCE[0]}
tar -xf ${SOURCE[1]}
chown -R root:root .
chmod -R u+w,go+r-w,a+rX-st .

# --- The Zyn-Fusion user interface (libzest.so + zest launcher) ---
cd $TMP/tmp-$PRGNAM/zyn-fusion-ui-src-${VERSION}
echo Building the Zyn-Fusion UI ...
# mruby takes CFLAGS from the environment; build_config.rb adds -std=gnu99.
# BUILD_MODE=release: no demo mode.
CFLAGS="$SLKCFLAGS" \
BUILD_MODE=release \
VERSION=$VERSION \
  make 2>&1 | tee $OUTPUT/make-${PRGNAM}.log
make pack 2>&1 | tee -a $OUTPUT/make-${PRGNAM}.log

# --- ZynAddSubFX with the zest GUI module ---
cd $TMP/tmp-$PRGNAM/zynaddsubfx-${VERSION}

# Add a missing include:
cat $SRCDIR/patches/zynaddsubfx_cstdint.patch | patch -p1 --verbose \
  2>&1 | tee $OUTPUT/patch-${PRGNAM}.log
# Build against mxml 4:
cat $SRCDIR/patches/zynaddsubfx-3.0.6-mxml4.patch | patch -p1 --verbose \
  2>&1 | tee -a $OUTPUT/patch-${PRGNAM}.log

echo Building ZynAddSubFX ...
mkdir -p build-zynaddsubfx
pushd build-zynaddsubfx
  cmake .. \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMAKE_C_FLAGS:STRING="$SLKCFLAGS" \
    -DCMAKE_CXX_FLAGS:STRING="$SLKCFLAGS" \
    -DCMAKE_C_FLAGS_RELEASE:STRING="$SLKCFLAGS" \
    -DCMAKE_CXX_FLAGS_RELEASE:STRING="$SLKCFLAGS" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DMAN_INSTALL_DIR=/usr/man \
    -DSYSCONF_INSTALL_DIR=/etc \
    -DLIB_SUFFIX=${LIBDIRSUFFIX} \
    -DDefaultOutput=jack \
    -DDefaultInput=jack \
    -DGuiModule=zest \
    -DDemoMode=OFF \
    -DJackEnable=ON \
    -DPluginLibDir=lib${LIBDIRSUFFIX} \
    2>&1 | tee $OUTPUT/configure-${PRGNAM}.log
  make $NUMJOBS 2>&1 | tee -a $OUTPUT/make-${PRGNAM}.log
  make DESTDIR=$PKG install 2>&1 | tee $OUTPUT/install-${PRGNAM}.log
popd

# Install the UI where zynaddsubfx and the plugin UIs look for it
# (same layout as upstream's binary release and install-linux.sh):
ZEST=$TMP/tmp-$PRGNAM/zyn-fusion-ui-src-${VERSION}/package
mkdir -p $PKG/opt/zyn-fusion/qml
install -m 0755 $ZEST/libzest.so $PKG/opt/zyn-fusion/libzest.so
install -m 0755 $ZEST/zest $PKG/opt/zyn-fusion/zyn-fusion
cp -a $ZEST/font $ZEST/schema $PKG/opt/zyn-fusion/
# Only checked for existence, the QML is built into libzest.so:
touch $PKG/opt/zyn-fusion/qml/MainWindow.qml
mkdir -p $PKG/usr/bin
ln -sf ../../opt/zyn-fusion/zyn-fusion $PKG/usr/bin/zyn-fusion
install -Dm 0644 $ZEST/completions/zyn-fusion \
  $PKG/usr/share/bash-completion/completions/zyn-fusion

# Docs generation requires asciidoctor now, so we will just do ourselves:
a2x --doctype manpage --format manpage doc/zynaddsubfx.1.txt || true
asciidoc --doctype article doc/zynaddsubfx.txt || true

# Install banks and examples:
mkdir -p ${PKG}/usr/share/zynaddsubfx
cp -a instruments/banks ${PKG}/usr/share/zynaddsubfx
cp -a instruments/examples ${PKG}/usr/share/zynaddsubfx

# Install application icons:
install -Dm 0644 zynaddsubfx.ico ${PKG}/usr/share/pixmaps/zynaddsubfx.ico
convert zynaddsubfx.ico ${PKG}/usr/share/pixmaps/zynaddsubfx.png || true
install -Dm 0644 zynaddsubfx.svg \
  ${PKG}/usr/share/icons/hicolor/scalable/apps/zynaddsubfx.svg

# Install the man page:
if [ -f doc/zynaddsubfx.1 ]; then
  install -Dm 0644 doc/zynaddsubfx.1 ${PKG}/usr/man/man1/zynaddsubfx.1
fi

# Add 'X-DAW' category to the desktop file (for liveslak):
for DESKTOPF in $PKG/usr/share/applications/*.desktop ; do
  if ! grep -q X-DAW $DESKTOPF ; then
    sed -i $DESKTOPF \
      -e "s/^Categories=\(.*\)/Categories=X-DAW;\1/"
  fi
done

# Add this to the doinst.sh:
mkdir -p $PKG/install
cat <<EOINS >> $PKG/install/doinst.sh
# Give zynaddsubfx realtime capabilities (it links to Jack2):
if [ -x /sbin/setcap ]; then
  if [ -n "\$(readelf -d usr/bin/zynaddsubfx | grep libjack.so)" ]; then
    /sbin/setcap cap_ipc_lock,cap_sys_nice=ep usr/bin/zynaddsubfx
  fi
fi

# Update the desktop database:
if [ -x usr/bin/update-desktop-database ]; then
  chroot . /usr/bin/update-desktop-database usr/share/applications > /dev/null 2>&1
fi

# Update hicolor theme cache:
if [ -d usr/share/icons/hicolor ]; then
  if [ -x /usr/bin/gtk-update-icon-cache ]; then
    chroot . /usr/bin/gtk-update-icon-cache -f -t usr/share/icons/hicolor 1> /dev/null 2> /dev/null
  fi
fi

# Update the mime database:
if [ -x usr/bin/update-mime-database ]; then
  chroot . /usr/bin/update-mime-database usr/share/mime >/dev/null 2>&1
fi

EOINS

# Add documentation:
mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cp -a $DOCS $PKG/usr/doc/$PRGNAM-$VERSION || true
cp -a doc/zynaddsubfx.html ${PKG}/usr/doc/${PRGNAM}-${VERSION}/ || true
cp -a doc/images ${PKG}/usr/doc/${PRGNAM}-${VERSION}/ || true
cp -a $TMP/tmp-$PRGNAM/zyn-fusion-ui-src-${VERSION}/LICENSE \
  $PKG/usr/doc/$PRGNAM-$VERSION/LICENSE.zyn-fusion
cp -a $TMP/tmp-$PRGNAM/zyn-fusion-ui-src-${VERSION}/README.adoc \
  $PKG/usr/doc/$PRGNAM-$VERSION/README.zyn-fusion.adoc
cat $SRCDIR/slack-required > $PKG/usr/doc/$PRGNAM-$VERSION/slack-required
cat $SRCDIR/$(basename $0) > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild
chown -R root:root $PKG/usr/doc/$PRGNAM-$VERSION
find $PKG/usr/doc -type d -exec chmod 755 {} \;
find $PKG/usr/doc -type f -exec chmod 644 {} \;
# Remove the unwanted bits;
rm -rf $PKG/usr/share/doc

# Compress the man page(s):
if [ -d $PKG/usr/man ]; then
  find $PKG/usr/man -type f -name "*.?" -exec gzip -9f {} \;
  for i in $(find $PKG/usr/man -type l -name "*.?") ; do ln -s $( readlink $i ).gz $i.gz ; rm $i ; done
fi

# Strip binaries (libzest.so has debug info, mruby builds with -g):
find $PKG | xargs file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

# Add a package description:
mkdir -p $PKG/install
cat $SRCDIR/slack-desc > $PKG/install/slack-desc
cat $SRCDIR/slack-required > $PKG/install/slack-required

# Build the package:
cd $PKG
makepkg --linkadd y --chown n $OUTPUT/${PRGNAM}-${VERSION}-${ARCH}-${BUILD}${TAG}.${PKGTYPE:-txz} 2>&1 | tee $OUTPUT/makepkg-${PRGNAM}.log
cd $OUTPUT
md5sum ${PRGNAM}-${VERSION}-${ARCH}-${BUILD}${TAG}.${PKGTYPE:-txz} > ${PRGNAM}-${VERSION}-${ARCH}-${BUILD}${TAG}.${PKGTYPE:-txz}.md5
cd -
cat $PKG/install/slack-desc | grep "^${PRGNAM}" > $OUTPUT/${PRGNAM}-${VERSION}-${ARCH}-${BUILD}${TAG}.txt
cat $PKG/install/slack-required > $OUTPUT/${PRGNAM}-${VERSION}-${ARCH}-${BUILD}${TAG}.dep

# Restore the original umask:
umask ${_UMASK_}
