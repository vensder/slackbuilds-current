#!/bin/bash

# Slackware build script for JamesDSP for Linux
#
# Based on the SBo JDSP4Linux.SlackBuild by Ralph Spitzner (sbo/JDSP4Linux).
# Source: the upstream tag (Audio4Linux/JDSP4Linux) cloned with its
# submodules and packed into JDSP4Linux-$VERSION.tar.gz (GitHub tag
# tarballs lack the submodules). Needs git for the first build.
#
# Redistribution and use of this script, with or without modification, is
# permitted provided that the following conditions are met:
#
# 1. Redistributions of this script must retain the above copyright
#    notice, this list of conditions and the following disclaimer.
#
#  THIS SOFTWARE IS PROVIDED BY THE AUTHOR "AS IS" AND ANY EXPRESS OR IMPLIED
#  WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF
#  MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO
#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=JDSP4Linux
VERSION=${VERSION:-2.7.0}
BUILD=${BUILD:-1}
TAG=${TAG:-vensder}
PKGTYPE=${PKGTYPE:-txz}

GITURL=https://github.com/Audio4Linux/JDSP4Linux.git
# Not downloaded (no submodules in it): only for the version check of
# scripts/build-slackbuild.sh (GitHub releases, tags named like 2.7.0)
SRCURL="https://github.com/Audio4Linux/JDSP4Linux/archive/${VERSION}/JDSP4Linux-${VERSION}.tar.gz"

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/build}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

# Made from a recursive clone of the tag; unpacks to JDSP4Linux-$VERSION/
SOURCE=$CWD/$PRGNAM-$VERSION.tar.gz

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT

if ! [ -f $SOURCE ]; then
  echo "Cloning tag $VERSION with submodules..."
  rm -rf $TMP/git-$PRGNAM
  mkdir -p $TMP/git-$PRGNAM
  git clone --depth 1 --branch $VERSION --recursive --shallow-submodules \
    $GITURL $TMP/git-$PRGNAM/$PRGNAM-$VERSION
  tar -czf $SOURCE --exclude=.git -C $TMP/git-$PRGNAM $PRGNAM-$VERSION
  rm -rf $TMP/git-$PRGNAM
fi

cd $TMP
rm -rf $PRGNAM-$VERSION
tar xvf $SOURCE
cd $PRGNAM-$VERSION
chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} \; -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;

# From the SBo SlackBuild: build with clang
sed -i '1s/^/QMAKE_CC = clang\nQMAKE_CXX = clang++\nQMAKE_LINK=clang++\n/' src/src.pro

# GCC 14+ makes these errors in the bundled C library (libjamesdsp is built
# with gcc, not clang): keep them warnings as with older GCC
sed -i '1s/^/QMAKE_CFLAGS += -Wno-error=incompatible-pointer-types -Wno-error=implicit-int -Wno-error=implicit-function-declaration -Wno-error=int-conversion\n/' \
  libjamesdsp/libjamesdsp.pro

# PipeWire 1.4+ turned pw_<type>_add_listener() into typed inline functions:
# C++ no longer converts the pw_proxy * argument, cast it
sed -i -E 's/pw_(node|link|module|client|device|metadata)_add_listener\(proxy,/pw_\1_add_listener(reinterpret_cast<struct pw_\1 *>(proxy),/' \
  src/audio/pipewire/*.cpp

mkdir build
cd build
# PipeWire by default; PULSE=yes for the PulseAudio backend
if [ -z "${PULSE:-}" ]; then
  qmake-qt5 ../JDSP4Linux.pro
else
  qmake-qt5 ../JDSP4Linux.pro "CONFIG += USE_PULSEAUDIO"
fi

make -j$(nproc)

mkdir -p $PKG/usr/bin
cp src/jamesdsp $PKG/usr/bin

mkdir -p $PKG/usr/share/applications
cat <<EOT > $PKG/usr/share/applications/jamesdsp.desktop
[Desktop Entry]
Name=JamesDSP
GenericName=Audio effect processor
Comment=JamesDSP for Linux
Keywords=equalizer;audio;effect
Categories=AudioVideo;Audio;
Exec=jamesdsp
Icon=jamesdsp
StartupNotify=false
Terminal=false
Type=Application
EOT

mkdir -p $PKG/usr/share/pixmaps
cat ../resources/icons/icon.png > $PKG/usr/share/pixmaps/jamesdsp.png

find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
for f in ../LICENSE ../README.md ../BUILD.md; do
  if [ -e $f ]; then cp -a $f $PKG/usr/doc/$PRGNAM-$VERSION; fi
done
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat $CWD/doinst.sh > $PKG/install/doinst.sh

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
